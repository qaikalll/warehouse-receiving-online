// CANDIDATE ONLY. Do not replace production rules without exporting and comparing
// the current rules, migrating canonical profiles/DO reservations, and emulator tests.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && user().active == true && user().email == request.auth.token.email; }
    function admin() { return active() && user().role == 'admin'; }
    function editor() { return active() && user().role in ['admin','staff']; }
    function ownCompany(d) { return active() && user().role == 'client' && d.companyId == user().companyId; }
    function canRead(d) { return editor() || ownCompany(d); }
    function qty(q) { return q is number && q >= 0 && q < 1000000000; }
    function text(v) { return v is string && v.size() > 0 && v.size() <= 1000; }
    function requestId(d) { return d.guardianRequestId is string && d.guardianRequestId.size() <= 100; }
    function baseRecord(d) {
      return requestId(d) && text(d.doNumber) && text(d.poNumber) && text(d.companyId)
        && text(d.customer) && qty(d.expectedQty) && d.updatedAt is string;
    }
    function receiving(d) {
      return baseRecord(d) && d.shipmentDate is string && d.shipmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && text(d.vehicleNumber) && text(d.transportType)
        && (d.actualQty == '' || qty(d.actualQty))
        && d.arrivalTime is string && d.startTime is string && d.completionTime is string
        && (d.startTime == '' || (d.arrivalTime != '' && d.startTime >= d.arrivalTime))
        && (d.completionTime == '' || (d.startTime != '' && d.completionTime >= d.startTime && qty(d.actualQty)));
    }
    function transition(a,b) {
      return (a.arrivalTime == '' || a.arrivalTime == b.arrivalTime)
        && (a.startTime == '' || a.startTime == b.startTime)
        && (a.completionTime == '' || a.completionTime == b.completionTime)
        && (a.arrivalTime != '' || b.startTime == '')
        && (a.startTime != '' || b.completionTime == '');
    }
    function keyPart(v) { return v.replace('%','%25').replace('/','%2F').replace('[|]','%7C'); }
    function doKey(d) { return keyPart(d.companyId) + '|' + keyPart(d.doNumber.trim().lower()); }
    function reserved(d,id) {
      let key = getAfter(/databases/$(database)/documents/guardian_do_keys/$(d.guardianDoKey)).data;
      return d.guardianDoKey == doKey(d) && key.receivingId == id && key.companyId == d.companyId;
    }
    function validSlot(d) { return d.slotStart + '-' + d.slotEnd in ['08:00-08:30','08:30-09:00','09:00-09:30','09:30-10:00','10:00-10:30','10:30-11:00','11:00-11:30','11:30-12:00','12:00-12:30','12:30-13:00','14:00-14:30','14:30-15:00','15:00-15:30','15:30-16:00','16:00-16:30','16:30-17:00','17:00-17:30','17:30-18:00','18:00-18:30']; }
    function slotId(date,start) { return date + '_' + start.replace(':',''); }
    function bookedReceiving(d,id) {
      let s=getAfter(/databases/$(database)/documents/booking_slots/$(slotId(d.shipmentDate,d.bookingSlotStart))).data;
      return s.receivingId == id && s.booked == true && s.date == d.shipmentDate
        && s.slotStart == d.bookingSlotStart && s.slotEnd == d.bookingSlotEnd && validSlot(s);
    }
    function validProfile(d) {
      return d.role in ['admin','staff','client'] && d.active is bool && text(d.email)
        && text(d.companyId) && text(d.companyName)
        && (d.role != 'client' || d.companyId != '__ALL__');
    }
    function audited(uid,d,previousRole) {
      let a = getAfter(/databases/$(database)/documents/guardian_role_audit/$(d.roleAuditId)).data;
      return a.targetUid == uid && a.actorUid == request.auth.uid && a.previousRole == previousRole
        && a.newRole == d.role && a.guardianRequestId == d.guardianRequestId;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin() && validProfile(request.resource.data) && audited(uid,request.resource.data,'none');
      allow update: if (
        admin() && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && (resource.data.get('roleLocked',false) != true || (request.resource.data.role == resource.data.role && request.resource.data.roleLocked == true))
        && (uid != request.auth.uid || (request.resource.data.role == 'admin' && request.resource.data.active == true))
        && audited(uid,request.resource.data,resource.data.role)
      ) || (
        active() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','pushNotificationsEnabled','fcmTokens','fcmSdk','pushTransport','lastPushRegisteredAt'
        ])
      );
      allow delete: if false;
    }
    match /guardian_role_audit/{id} {
      allow read: if admin();
      allow create: if admin() && requestId(request.resource.data)
        && request.resource.data.actorUid == request.auth.uid
        && !exists(/databases/$(database)/documents/guardian_role_audit/$(id))
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetUid)).data.roleAuditId == id
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetUid)).data.role == request.resource.data.newRole;
      allow update,delete: if false;
    }
    match /receivings/{id} {
      allow read: if canRead(resource.data);
      allow create: if receiving(request.resource.data) && reserved(request.resource.data,id)
        && request.resource.data.startTime == '' && request.resource.data.completionTime == ''
        && (editor() || (ownCompany(request.resource.data) && request.resource.data.source == 'client-booking'
          && request.resource.data.arrivalTime == '' && request.resource.data.bookedBy == request.auth.token.email
          && bookedReceiving(request.resource.data,id)));
      allow update: if editor() && receiving(request.resource.data) && transition(resource.data,request.resource.data)
        && reserved(request.resource.data,id);
      allow delete: if editor();
    }
    match /guardian_do_keys/{key} {
      allow read: if active();
      allow create,update: if active() && requestId(request.resource.data)
        && (!exists(/databases/$(database)/documents/guardian_do_keys/$(key)) || resource.data.receivingId == request.resource.data.receivingId)
        && getAfter(/databases/$(database)/documents/receivings/$(request.resource.data.receivingId)).data.guardianDoKey == key
        && doKey(getAfter(/databases/$(database)/documents/receivings/$(request.resource.data.receivingId)).data) == key
        && (editor() || request.resource.data.companyId == user().companyId);
      allow delete: if editor() && (!existsAfter(/databases/$(database)/documents/receivings/$(resource.data.receivingId))
        || getAfter(/databases/$(database)/documents/receivings/$(resource.data.receivingId)).data.guardianDoKey != key);
    }
    match /discrepancies/{id} {
      allow read: if canRead(resource.data);
      allow create,update: if editor() && baseRecord(request.resource.data) && qty(request.resource.data.actualQty)
        && request.resource.data.reportDate is string && request.resource.data.reportDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && text(request.resource.data.sku) && text(request.resource.data.productName) && text(request.resource.data.issueType)
        && text(request.resource.data.itemCondition) && text(request.resource.data.actionTaken) && text(request.resource.data.pic)
        && request.resource.data.resolved is bool
        && (request.resource.data.photo == '' || (request.resource.data.photo is string && request.resource.data.photo.size() <= 700000 && request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,.*$')))
        && (request.resource.data.linkedReceivingId == '' || getAfter(/databases/$(database)/documents/receivings/$(request.resource.data.linkedReceivingId)).data.companyId == request.resource.data.companyId);
      allow delete: if editor();
    }
    match /booking_slots/{id} {
      allow read: if active();
      allow create,update: if active() && requestId(request.resource.data) && request.resource.data.booked == true
        && validSlot(request.resource.data) && id == slotId(request.resource.data.date,request.resource.data.slotStart)
        && (!exists(/databases/$(database)/documents/booking_slots/$(id)) || resource.data.booked == false)
        && getAfter(/databases/$(database)/documents/receivings/$(request.resource.data.receivingId)).data.shipmentDate == request.resource.data.date
        && getAfter(/databases/$(database)/documents/receivings/$(request.resource.data.receivingId)).data.bookingSlotStart == request.resource.data.slotStart
        && (editor() || getAfter(/databases/$(database)/documents/receivings/$(request.resource.data.receivingId)).data.companyId == user().companyId);
      allow delete: if editor();
    }
    match /companies/{id} { allow read: if active(); allow write: if admin(); }
    match /returns/{id} {
      allow read: if canRead(resource.data);
      allow create,update: if editor() && requestId(request.resource.data) && text(request.resource.data.tracking)
        && text(request.resource.data.companyId) && request.resource.data.items is list && request.resource.data.items.size()>0
        && qty(request.resource.data.totalQty) && request.resource.data.status in ['Pending Inspection','Pending Client Decision','Completed'];
      allow delete: if editor();
    }
    match /guardian_incidents/{id} {
      allow read: if admin() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.severity in ['INFO','WARNING','ERROR','CRITICAL']
        && request.resource.data.message is string && request.resource.data.message.size()<=300;
      allow update: if active() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result','recoveredAt','persisted']);
      allow delete: if false;
    }
  }
}
